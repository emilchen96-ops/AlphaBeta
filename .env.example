# Local development only. Copy to .env and replace placeholders when needed.
POSTGRES_DB=alphadesk
POSTGRES_USER=alphadesk
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=5173

ALPHADESK_ENVIRONMENT=development
ALPHADESK_PRODUCT_MODE=RESEARCH_ONLY
ALPHADESK_DEBUG=false
ALPHADESK_LOG_LEVEL=INFO
ALPHADESK_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALPHADESK_WEBSOCKET_HEARTBEAT_SECONDS=20
ALPHADESK_CORRELATION_ID_HEADER=X-Correlation-ID
ALPHADESK_EXTERNAL_MARKET_DATA_ENABLED=false
ALPHADESK_FREE_MARKET_ENABLED=false
ALPHADESK_REALTIME_MARKET_PROVIDER=disabled
ALPHADESK_HISTORICAL_MARKET_PROVIDER=miniqmt
ALPHADESK_AUTHORITATIVE_MARKET_SOURCE=MINIQMT
ALPHADESK_ALLOW_TEST_MARKET_DATA=false
# MD01 uses the Windows-hosted MiniQMT read-only gateway as the sole formal source.
# Keep the token only in the untracked .env and use the same value for API and Agent.
ALPHADESK_MINIQMT_MARKET_DATA_ENABLED=true
ALPHADESK_MINIQMT_DATA_PATH=D:\QTM\DWZQ_QMT\userdata_mini
ALPHADESK_MINIQMT_XTQUANT_PATH=
ALPHADESK_MINIQMT_AGENT_API_URL=http://127.0.0.1:8000
ALPHADESK_MINIQMT_AGENT_TOKEN=
ALPHADESK_MINIQMT_MAX_SUBSCRIPTIONS=200
ALPHADESK_MINIQMT_BENCHMARK_SYMBOLS=["510300.SSE","510500.SSE"]
ALPHADESK_MINIQMT_HISTORY_MAX_INSTRUMENTS=50
ALPHADESK_MINIQMT_HISTORY_MAX_DAYS=3650
ALPHADESK_MINIQMT_QUOTE_TTL_SECONDS=300
# SC01-R full-market scanner worker and MiniQMT history preparation batches.
ALPHADESK_SCANNER_WORKER_POLL_MS=1000
ALPHADESK_SCANNER_WORKER_HEARTBEAT_SECONDS=5
ALPHADESK_SCANNER_BACKFILL_BATCH_SIZE=50
ALPHADESK_SCANNER_BACKFILL_WAIT_SECONDS=120
ALPHADESK_SCANNER_SCAN_BATCH_SIZE=250
# D02 reference data defaults to deterministic offline fixtures. Tushare remains
# disabled unless both flags are set locally; never commit a real token.
TUSHARE_ENABLED=false
TUSHARE_TOKEN=
MARKET_CALENDAR_PROVIDER=verified
MARKET_ADJUSTMENT_PROVIDER=fixture
MARKET_SUSPENSION_PROVIDER=fixture
ALPHADESK_FREE_MARKET_DATA_ENABLED=false
ALPHADESK_AI_RESEARCH_PROVIDER=disabled
# OpenAI-compatible Chat Completions provider. Keep the real key only in untracked .env
# or another local Secret mechanism. Never commit it and never use a VITE_ prefix.
ALPHADESK_AI_BASE_URL=
ALPHADESK_AI_API_KEY=
ALPHADESK_AI_MODEL=
ALPHADESK_AI_REQUEST_TIMEOUT_SECONDS=30
ALPHADESK_AI_MAX_RETRIES=1
ALPHADESK_AI_MAX_INPUT_CHARACTERS=50000
ALPHADESK_AI_MAX_OUTPUT_TOKENS=2000
ALPHADESK_AI_TEMPERATURE=0.1
ALPHADESK_AI_COST_INPUT_PER_MILLION=
ALPHADESK_AI_COST_OUTPUT_PER_MILLION=
ALPHADESK_AI_STRUCTURED_OUTPUT_ENABLED=true
ALPHADESK_AI_RESEARCH_WORKER_POLL_MS=1000
ALPHADESK_AI_RESEARCH_TASK_STALE_SECONDS=300
ALPHADESK_FREE_MARKET_POLL_SECONDS=30
ALPHADESK_FREE_MARKET_IDLE_POLL_SECONDS=120
ALPHADESK_FREE_MARKET_CLOSED_POLL_SECONDS=600
ALPHADESK_FREE_MARKET_MINUTE_SYNC_SECONDS=300
ALPHADESK_FREE_MARKET_MINUTE_MAX_SYMBOLS=20
ALPHADESK_FREE_MARKET_MINUTE_LOOKBACK_MINUTES=120
ALPHADESK_FREE_MARKET_PROVIDER_MIN_INTERVAL_SECONDS=5
ALPHADESK_FREE_MARKET_PROVIDER_MAX_CONCURRENCY=1
ALPHADESK_FREE_MARKET_PROVIDER_MAX_RETRIES=2
ALPHADESK_FREE_MARKET_CIRCUIT_FAILURE_THRESHOLD=5
ALPHADESK_FREE_MARKET_CIRCUIT_OPEN_SECONDS=600
ALPHADESK_FREE_MARKET_QUOTE_TTL_SECONDS=120
ALPHADESK_FREE_MARKET_STALE_SECONDS=60
ALPHADESK_RISK_MAX_ORDER_NOTIONAL=1000000
ALPHADESK_RISK_MAX_INSTRUMENT_WEIGHT=1
ALPHADESK_RISK_MAX_TOTAL_EXPOSURE=1
ALPHADESK_RISK_MAX_ORDERS_PER_WINDOW=20
ALPHADESK_RISK_ORDER_FREQUENCY_WINDOW_SECONDS=60
ALPHADESK_RISK_ALLOW_MARKET_ORDERS=false
ALPHADESK_RISK_REQUIRE_REFERENCE_PRICE_FOR_MARKET_ORDER=true
ALPHADESK_RISK_KILL_SWITCH_ENABLED=false
ALPHADESK_BACKTEST_MAX_INSTRUMENTS=20
ALPHADESK_BACKTEST_MAX_BARS=100000
ALPHADESK_BACKTEST_MAX_SESSIONS=5000
ALPHADESK_MARKET_BAR_QUERY_LIMIT=2000
ALPHADESK_MARKET_SYNC_BATCH_SIZE=500
ALPHADESK_MARKET_BACKFILL_BATCH_SIZE=500
ALPHADESK_MARKET_BACKFILL_REQUEST_INTERVAL_SECONDS=0.1
ALPHADESK_MARKET_BACKFILL_MAX_RETRIES=2
ALPHADESK_MARKET_BACKFILL_MAX_INSTRUMENTS=500
ALPHADESK_MARKET_DAILY_DEFAULT_START_DATE=2023-01-01
ALPHADESK_MARKET_DATA_STALE_CALENDAR_DAYS=7
ALPHADESK_MARKET_DATA_BACKTEST_MINIMUM_BARS=250
# A future provider token belongs only in an untracked local secret environment variable.
# Free providers remain disabled by default and are research-only, non-trading-grade data.
# Destructive migration tests reject URLs whose database name does not contain "test".
ALPHADESK_TEST_DATABASE_URL=postgresql+asyncpg://alphadesk_test:local-test-placeholder@postgres_test:5432/alphadesk_test

# Browser-visible values must be non-sensitive and use VITE_ prefixes.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
