# Local development only. Copy to .env and replace placeholders when needed.
POSTGRES_DB=alphadesk
POSTGRES_USER=alphadesk
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=5173

ALPHADESK_ENVIRONMENT=development
ALPHADESK_DEBUG=false
ALPHADESK_LOG_LEVEL=INFO
ALPHADESK_CORS_ORIGINS=["http://localhost:5173"]
ALPHADESK_WEBSOCKET_HEARTBEAT_SECONDS=20
ALPHADESK_CORRELATION_ID_HEADER=X-Correlation-ID
ALPHADESK_EXTERNAL_MARKET_DATA_ENABLED=false
ALPHADESK_MARKET_BAR_QUERY_LIMIT=2000
ALPHADESK_MARKET_SYNC_BATCH_SIZE=500
# A future provider token belongs only in an untracked local secret environment variable.
# No external provider is enabled in M03.
# Destructive migration tests reject URLs whose database name does not contain "test".
ALPHADESK_TEST_DATABASE_URL=postgresql+asyncpg://alphadesk_test:local-test-placeholder@postgres_test:5432/alphadesk_test

# Browser-visible values must be non-sensitive and use VITE_ prefixes.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
